{
	"name": "@prismicio/vue",
	"version": "6.2.0",
	"description": "Vue plugin, components, and composables to fetch and present Prismic content",
	"keywords": [
		"plugin",
		"prismic",
		"typescript",
		"vue"
	],
	"license": "Apache-2.0",
	"author": "Prismic <contact@prismic.io> (https://prismic.io)",
	"repository": {
		"type": "git",
		"url": "ssh://git@github.com/prismicio/prismic-vue.git"
	},
	"workspaces": [
		".",
		"e2e-projects/*"
	],
	"files": [
		"./dist",
		"./src"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"e2e": "npm run build && playwright test",
		"e2e:ui": "npm run e2e -- --ui",
		"format": "oxfmt",
		"prepare": "npm run build",
		"lint": "oxlint --deny-warnings",
		"types": "vue-tsc --noEmit",
		"test": "npm run lint && npm run types && npm run e2e"
	},
	"dependencies": {
		"@prismicio/simulator": "^0.2.4",
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@prismicio/client": "^7.23.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"oxfmt": "0.77.0",
		"oxlint": "1.93.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vue": "^3.5.45",
		"vue-tsc": "^3.3.14"
	},
	"peerDependencies": {
		"@prismicio/client": "^7",
		"vue": "^3"
	},
	"engines": {
		"node": ">=22"
	}
}
